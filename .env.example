DATABASE_URL="postgresql://vault:vault@localhost:5432/gamevault?schema=public"
# Display name used in the audit trail when no auth provider is configured
APP_USER="Owner"
# ISO currency code for formatting
NEXT_PUBLIC_CURRENCY="USD"
# Owner login — generate both with: npm run auth:setup
AUTH_SECRET=""
OWNER_PASSWORD_HASH=""
# Set to "true" only if you serve production over plain HTTP on a private network
AUTH_INSECURE_COOKIE="false"
